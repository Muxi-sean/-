{
    "name": "appjet/trade-search",
    "description": "Trade information search backend with ThinkPHP 6",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.1",
        "elasticsearch/elasticsearch": "^8.0",
        "topthink/think-cors": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
